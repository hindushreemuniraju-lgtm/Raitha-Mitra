# ==============================================================================
# Raitha Mitra Backend Environment Configuration
# Copy this file to backend/.env and populate credentials as needed.
# NEVER commit backend/.env or expose keys to frontend code.
# ==============================================================================

# --- Core Application & Security ---
APP_ENV=development
APP_NAME=Raitha Mitra
SECRET_KEY=replace-with-at-least-32-bytes-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Local development (SQLite):
DATABASE_URL=sqlite:///./raithamitra.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://raithamitra:strongpassword@localhost:5432/raithamitra
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
SOIL_DATASET_PATH=./data/soil_datasets

# --- Voice Assistant (LiveKit + Sarvam AI) ---
# Requires LiveKit Cloud or self-hosted LiveKit server + Sarvam AI API credits
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_LLM_MODEL=sarvam-105b

# --- Weather & Flood ---
# IMD: Requires institutional/developer registration & static IP whitelisting at api.imd.gov.in
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
IMD_USERNAME=
IMD_PASSWORD=
IMD_WARNINGS_PATH=/api/v1/district_warning
IMD_FORECAST_PATH=/api/v1/cityforecast

# OpenWeatherMap: Fallback for FORECASTS ONLY (never IMD warnings)
# Mode '2.5' uses free /data/2.5/weather & /data/2.5/forecast; '3.0' uses One Call 3.0 (card required)
OPENWEATHER_API_KEY=
OPENWEATHER_MODE=2.5

# CWC Flood Forecasting: No public self-service REST API (ffs.india-water.gov.in is portal-only).
# Configure only if granted official institutional feed access by CWC/NWIC.
CWC_API_URL=
CWC_API_KEY=

# --- Pest & Disease Detection ---
# Plantix Intelligence API: Requires commercial B2B partner approval via b2b.plantix.net
PLANTIX_BASE_URL=
PLANTIX_API_KEY=

# Pluggable Fallback Vision Model (OpenAI-compatible multimodal chat completions endpoint)
VISION_MODEL_BASE_URL=
VISION_MODEL_API_KEY=
VISION_MODEL_NAME=

# --- Yield & Landscape Metadata ---
# Google Agricultural Understanding Platform (ALU/AMED): provides field boundaries, sowing/harvest dates (NOT yield)
GOOGLE_AGRI_API_KEY=

# --- Nutrition & Utilization ---
# USDA FoodData Central (free key via https://fdc.nal.usda.gov/api-key-signup/)
USDA_FDC_API_KEY=
# NCBI PubMed E-utilities (works without key at 3 req/s; key increases to 10 req/s)
NCBI_API_KEY=
NCBI_TOOL_NAME=RaithaMitra
NCBI_CONTACT_EMAIL=

# --- Mandi Prices ---
# data.gov.in AGMARKNET daily commodity prices (free key via https://data.gov.in)
DATA_GOV_IN_API_KEY=
# CEDA Ashoka University Agmarknet API (free non-commercial signup via https://ceda.ashoka.edu.in)
CEDA_API_KEY=
CEDA_AUTH_HEADER=x-api-key
# e-NAM: No official public REST API documented; configure only with official partner feed
ENAM_API_URL=

# --- Government Schemes ---
# API Setu myScheme gateway (registration via https://directory.apisetu.gov.in)
APISETU_API_KEY=
APISETU_CLIENT_ID=

# --- Fertilizer Verified MRP Feed (Optional) ---
# Leave blank unless connected to a verified dated fertilizer MRP source
FERTILIZER_PRICE_API_URL=
FERTILIZER_PRICE_API_KEY=
